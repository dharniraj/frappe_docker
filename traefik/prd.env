# Environment for compose-erp-proxy.yaml

# Traefik router name (must be unique per stack on this traefik)
ROUTER=store-formigo
SITES_RULE=Host(`store.formigo.in`)

# External MariaDB (maria-db on mariadb_network)
DB_HOST=maria-db
DB_PORT=3306
DB_PASSWORD=daisoltech

FRAPPE_SITE_NAME_HEADER=frontend
FRAPPE_SITE_NAME_HOST=store.formigo.in

# Ofelia cron (seconds minutes hours day month weekday), evaluated in UTC time
# 20:30 UTC = 02:00 IST daily
BACKUP_CRONSTRING="0 30 20 * * *"

# ERPNext Administrator password (used only when create-site runs)
ADMIN_PASSWORD=5Ks6qoDy0JOvxSpvJY9BmDW

# Custom Frappe/ERPNext image used by all bench services
FRAPPE_IMAGE=dharniraj/frappe-custom:15-8.10.26
